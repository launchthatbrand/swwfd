{
  "name": "swwfd",
  "packageManager": "pnpm@10.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=./packages/* && next build",
    "build:web": "next build",
    "clean": "rm -rf .cache .next .turbo node_modules",
    "dev": "next dev --turbo --port 3600 --hostname 0.0.0.0",
    "dev:packages": "turbo run dev --parallel --continue --filter=./packages/*",
    "format": "prettier --check .",
    "lint": "turbo run lint --filter=./packages/* && eslint",
    "smoke": "pnpm smoke:consumer",
    "smoke:consumer": "bash scripts/smoke/private-package-consumer-smoke.sh",
    "start": "next start",
    "test:email-routing": "node --test --experimental-strip-types --experimental-specifier-resolution=node \"src/server/email/providers/*.test.ts\"",
    "typecheck": "turbo run typecheck --filter=./packages/* && tsc --noEmit",
    "typecheck:phase1": "tsc --project tsconfig.phase1.json --noEmit"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/agent": "^0.3.2",
    "@convex-dev/auth": "^0.0.90",
    "@convex-dev/crons": "^0.2.0",
    "@convex-dev/presence": "^0.3.0",
    "@convex-dev/rag": "^0.7.2",
    "@convex-dev/workflow": "^0.3.3",
    "@dnd-kit/core": "^6.3.1",
    "@launchthatapp/dnd": "^0.1.1",
    "@launchthatapp/ui": "0.1.2",
    "@mdx-js/mdx": "^3.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@swwfd/admin-runtime": "workspace:*",
    "@swwfd/ai": "workspace:*",
    "@swwfd/plugin-core": "workspace:*",
    "@swwfd/plugin-langfuse": "workspace:*",
    "@swwfd/plugin-support": "workspace:*",
    "@swwfd/support-chat-composer": "workspace:*",
    "@swwfd/ui-lexical": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-form": "^1.12.1",
    "@tanstack/react-query": "^5.80.6",
    "@tiptap/extension-character-count": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-mention": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.17.4",
    "date-fns": "4.1.0",
    "docx-preview": "^0.3.7",
    "gray-matter": "^4.0.3",
    "jose": "5.9.6",
    "lucide-react": "^0.555.0",
    "monday-sdk-js": "^0.5.6",
    "motion": "^12.38.0",
    "next": "^16.2.9",
    "nextstepjs": "^2.2.0",
    "pdfjs-dist": "^5.7.284",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.74.0",
    "react-pdf": "^10.4.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0",
    "server-only": "^0.0.1",
    "superjson": "2.2.3",
    "tailwind-merge": "^3.3.1",
    "twilio": "^6.0.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.2",
    "@next/eslint-plugin-next": "^16.2.9",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jiti": "^2.5.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4.1.0",
    "turbo": "^2.5.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.27.0"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "^4.18.0"
    },
    "ignoredBuiltDependencies": []
  }
}
