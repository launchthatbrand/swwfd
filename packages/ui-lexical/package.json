    "@lexical/markdown": "^0.31.2",
    "@lexical/overflow": "^0.31.2",
    "@lexical/react": "^0.31.2",
    "@lexical/rich-text": "^0.31.2",
    "@lexical/selection": "^0.31.2",
    "@lexical/table": "^0.31.2",
    "@lexical/text": "^0.31.2",
    "@lexical/utils": "^0.31.2",
    "@radix-ui/react-dialog": "^1.1.15",
