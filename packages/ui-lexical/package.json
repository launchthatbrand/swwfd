{
  "name": "@swwfd/ui-lexical",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": {
    "./editor-x/editor": {
      "types": "./src/components/editor-x/editor.tsx",
      "default": "./src/components/editor-x/editor.tsx"
    },
    "./editor-x/viewer": {
      "types": "./src/components/editor-x/viewer.tsx",
      "default": "./src/components/editor-x/viewer.tsx"
    },
    "./*": "./src/*.tsx"
  },
  "license": "MIT",
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
